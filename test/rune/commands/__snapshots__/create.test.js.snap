// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`template > markdown format matches snapshot 1`] = `
"// permissions:
//   run:
//     allow: []  — add patterns like fs.read:./** if you use utils.fs
//     deny:  []

import { md, rune, section } from '@utils'

export async function args(b) {
  return b
    .option('-h, --help', 'Show help')
    .option('-v, --verbose', 'Verbose output', false)
}

export async function run(args) {
  const stop = rune.guard(args)
  if (stop) return stop

  // args._         — data positionals (command tokens stripped)
  // args.$rest     — unmapped positional arguments
  // args.verbose   — named flag (defined in args() above)

  const content = [
    md.h3('mykey'),
    md.ul(['Replace with real data']),
  ].join('\\n');
  return section.create('example-md', { type: 'markdown', content });
}
"
`;

exports[`template > tree format matches snapshot 1`] = `
"// permissions:
//   run:
//     allow: []  — add patterns like fs.read:./** if you use utils.fs
//     deny:  []

import { md, rune, section, tree } from '@utils'

export async function args(b) {
  return b
    .option('-h, --help', 'Show help')
    .option('-v, --verbose', 'Verbose output', false)
}

export async function run(args) {
  const stop = rune.guard(args)
  if (stop) return stop

  // args._         — data positionals (command tokens stripped)
  // args.$rest     — unmapped positional arguments
  // args.verbose   — named flag (defined in args() above)

  const root = tree.node('mykey', 'Root description', [
    tree.node('child', 'Child description'),
  ]);
  return section.create('example-tree', { type: 'tree', root });
}
"
`;
