{
  "runes": {
    "release": {
      "name": "Release Automator",
      "description": "Bump package versions, update changelogs, synchronize lockfiles, compile bundles, and tag Git releases automatically.",
      "batch": {
        "allow": [
          "info*"
        ]
      },
      "run": {
        "command": ".crunes/runes/release.rune.js",
        "permissions": {
          "allow": [
            "fs.read:package.json",
            "fs.read:package-lock.json",
            "fs.read:src/cli/program.js",
            "fs.read:CHANGELOG.md",
            "fs.write:package.json",
            "fs.write:src/cli/program.js",
            "fs.write:CHANGELOG.md",
            "shell.run:git log *",
            "shell.run:git rev-parse *",
            "shell.run:git describe *",
            "shell.run:git rev-list *",
            "shell.run:npm install",
            "shell.run:npm test",
            "shell.run:npm run build",
            "shell.run:git add package.json",
            "shell.run:git add package-lock.json",
            "shell.run:git add CHANGELOG.md",
            "shell.run:git add src/cli/program.js",
            "shell.run:git commit *",
            "shell.run:git tag *"
          ]
        }
      }
    },
    "m": {
      "name": "Module Structural Context",
      "description": "Live structural context (README and file tree) for modules.",
      "batch": {
        "allow": [
          "*"
        ]
      },
      "run": {
        "command": ".crunes/runes/m.rune.js",
        "permissions": {
          "allow": [
            "fs.read:src/**",
            "fs.glob:src/**::*",
            "fs.glob:src/**::**/*.js",
            "fs.exists:src/**"
          ]
        }
      }
    },
    "crunes-plugins@kb:kb": {
      "vars": {
        "roots": [
          "docs/kb/main"
        ]
      },
      "run": {
        "permissions": {
          "allow": [
            "fs.glob:docs/kb/main/**/*.md",
            "fs.read:docs/kb/main/**"
          ]
        }
      }
    }
  },
  "plugins": {
    "crunes-plugins@git": true,
    "crunes-plugins@kb": true
  }
}
